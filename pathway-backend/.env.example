# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Configuration
# Option 1: Local MongoDB
MONGODB_HOST=mongodb://localhost:27017/pathway
MONGODB_DB=pathway

# Option 2: MongoDB Atlas (Cloud)
# MONGODB_HOST=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/pathway?retryWrites=true&w=majority
# MONGODB_DB=pathway

# Anthropic API (for AI Companion)
# Paste your NVIDIA NIM API key here (get one at https://build.nvidia.com)
ANTHROPIC_API_KEY=your-nvidia-api-key-here

# CORS Settings (React frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
